# Copy to .lab.env. Never commit .lab.env.
LAB_TENANT_ID=
LAB_SUBSCRIPTION_ID=
LAB_LOCATION=swedencentral
# Keep rg-aks-lab: gitops/envs/aks-dev/gateway.yaml names it.
LAB_RESOURCE_GROUP=rg-aks-lab
LAB_BUDGET_EMAIL=
# Your Entra object ID. It receives the owner roles on Key Vault, App Configuration and the kind issuer storage.
LAB_OWNER_OBJECT_ID=
# Public URL of the kind issuer: output issuerUrl of the kind stack. No trailing slash.
LAB_ISSUER_URL=
# AKS node count, 1 to 3. Three nodes need 6 vCPU of quota in the region.
LAB_AKS_NODE_COUNT=3
