# Copy to .lab.env. Never commit .lab.env.
LAB_TENANT_ID=
LAB_SUBSCRIPTION_ID=
LAB_LOCATION=swedencentral
LAB_RESOURCE_GROUP=rg-aks-lab
LAB_BUDGET_EMAIL=
# Your Entra object ID. It receives the owner roles on Key Vault, App Configuration and the issuer storage.
LAB_OWNER_OBJECT_ID=
# Public URL of the kind issuer: Bicep output localIssuerUrl. No trailing slash.
LAB_ISSUER_URL=
